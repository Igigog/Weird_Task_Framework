  entities = {
    {
    id = 1234,
    huh = '@$ |this.id|',
    br1 = "@$ |this.id|",
    br3 = "$ |this.br2|",
    br2 = "$ |this.br1|",
    brbrbr = "$ |this.br3|",
    str = "@$ |this.brbrbr|"
  }
  }
