{
	"WTF_VERSION": "4.0",
	"CREDITS": "Arszi - idea and initial implementation\\nIgigog - support",
	"description": {
		"targets": [
			"$ igi_description.item_name_by_section(|item.section_name|)",
		 	"$ igi_target_fetch.fetch_amount_description(|item.section_name|, |item.amount|)"
		]
	},
	"entities": [
	{
		"link_id": "item",
		"CONTROLLER":"@$ igi_target_fetch.Fetch",
		"all_sections": "$ wtf.keys(igi_helper.db_ini:collect_section('arszi_ecologist'))",
		"valid_sections": "$ wtf.filter(|this.all_sections|, igi_helper.is_valid_section)",
		"section_name": "?$ wtf.shuffle(|this.valid_sections|)[1]",
		"amount":"$ igi_random.rand(1,4)"
	}
	],
	"rewards": {
		"money": "$ igi_target_fetch.calculate_cost(|item.section_name|, |item.amount|) * 2",
		"goodwill": 30
	},
	"quest_givers": [
		{"Sakharov": true}
	],
	"icon": "ui_inGame2_Specimen_Controller"
}