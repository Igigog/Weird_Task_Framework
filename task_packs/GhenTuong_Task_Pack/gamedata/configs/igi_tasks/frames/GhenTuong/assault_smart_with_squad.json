{
	"WTF_VERSION": "4.3",
    "inputs": {
        "smart_id": "number",
        "section_name": "string"
    },
	"entities": [
	{
		"id":"init$ |inputs.smart_id|",
		"CONTROLLER": "@$ igi_target_visit.Visit"
	},

    {
		"mutants_section": "$ 'gt_mutant_'..wtf_gt_tasks.scale_to_player()",
		"section_name":"$ igi_utils.random_table_value(igi_helper.db_ini:collect_section(|this.mutants_section|))",
		"id": "init$ igi_helper.spawn_squad(|this.section_name|, |inputs.smart_id|)",
		"HELPERS": ["@$ wtf.ScriptedSquad", "@$ wtf.PinToSmart"],
		"link_id": "squad"
	},

	{
		"id": "$ |inputs.smart_id|",
		"CONTROLLER":"@$ igi_target_assault.Assault"
	}
    ]
}