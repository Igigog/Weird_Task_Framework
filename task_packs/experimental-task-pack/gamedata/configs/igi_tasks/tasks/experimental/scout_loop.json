{
	"WTF_VERSION": "4.3",
	"CREDITS": "Igigog - creator",
    "description": {
        "locations": "$ wtf.map(|loop.ids|, igi_description.get_smart_name_by_id)"
	},
	"frames": [
    {
		"src": "Arszi/visit_smarts.json",
		"_ids": "@$ wtf.shuffle(igi_finder.get_smarts(0,0))",
		"ids": "@$ {|this._ids|[1]}",
        "link_id": "loop",
		"visited": {},

		"msg": "init@$ news_manager.send_tip(db.actor, \"Here's a new one for ya!\", nil, alife_object(|CACHE.task_giver_id|), 30000) or 1"
	},
    {
        "src": "core/countdown.json",
        "count": "$ igi_random.rand(0, 3)",
        "NEXT_FRAME": "@$ |this.count| == 0 and -1 or |loop.FRAME_ID|"
    }
	],
	"rewards": {
		"money": "@$ 200 + 200 * (#|loop.visited| == 0 and 4 or #|loop.visited|)",
		"goodwill": 50
	},
	"quest_givers": [
		{"Leader": true, "Agroprom": true, "Army": true},
        {"Leader": true, "ClearSky": true, "Marsh": true},
        {"Leader": true, "Freedom": true, "AW": true}
	],
	"icon": "ui_inGame2_Put_v_pripyat"
}