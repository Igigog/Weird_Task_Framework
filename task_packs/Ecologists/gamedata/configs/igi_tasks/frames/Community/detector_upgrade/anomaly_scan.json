{
    "inputs": {
        "zone_ids": "table",
        "scan_on_progress": "table",
        "visit_on_progress": "table",
        "sender": "number"
    },

    "outputs": {
        "detector_id": "init$ |detector.id|"
    },
    
    "entities": [
    {
        "section_name":"detector_anomaly",
        "id": "init$ igi_helper.give_to_actor(|this.section_name|)",
        "CONTROLLER":"@$ igi_target_get.Get",
        "link_id": "detector"
    },

    {
        "ids": "$ |inputs.zone_ids|",
        "GEN": "@$ igi_generate.Split('ids', 'id')",
        "range": 20,
        "CONTROLLER": "@$ wtf_target_anomaly_scan.AnomalyScan",
        "detector_id": "init$ |detector.id|",
        "scan_time_sec": 40,

        "ON_PROGRESS": "$ |inputs.scan_on_progress|",
        "subtask": true
    },

    {
        "ids": "$ |inputs.zone_ids|",
        "GEN": "@$ igi_generate.Split('ids', 'id')",
        "CONTROLLER": "@$ igi_target_visit.Visit",
        "ON_PROGRESS": "$ |inputs.visit_on_progress|"
    }
    ]
}