{
	"WTF_VERSION": "4.1",
	"CREDITS": "\\nNerkokant, Igigog - idea\\nIgigog - scripting\\nFolk - descriptions",
	"quest_givers": [],
	"icon": "ui_inGame2_Put_v_pripyat",
	"requirements": [
		"$ not game_relations.is_factions_enemies('ecolog', get_actor_true_community())"
	],
	"preconditions": [
		"$ get_actor_true_community() == 'ecolog'"
	],
	"description": {
		"locations": ["$ igi_description.anomaly_name_by_binder(|anomaly.binder|)"],
		"targets": ["$ igi_description.item_name_by_id(|arti.id|)"]
	},
	"entities": [
		{
			"link_id": "arti",
			"artefacts": "$ wtf_community_tasks.keys(bind_anomaly_zone.parent_zones_by_artefact_id)",
			"on_player_level": "$ wtf_community_tasks.filter_on_player_level(|this.artefacts|)",
			"id": "?$ igi_utils.get_random_items(|this.on_player_level|, 1)[1]"
		},

		{
			"binder": "@$ |arti.id| and bind_anomaly_zone.parent_zones_by_artefact_id[|arti.id|]",
			"id": "$ |this.binder| and |this.binder|.object:id()",
			"CONTROLLER": "@$ igi_target_visit.Visit",
			"link_id": "anomaly"
		},

		{
			"section_name": "$ alife_object(|arti.id|):section_name()",
			"CONTROLLER": "@$ igi_target_fetch.Fetch"
		}
	],
	"rewards": {
		"money": 5000,
		"goodwill": 100
	}
}