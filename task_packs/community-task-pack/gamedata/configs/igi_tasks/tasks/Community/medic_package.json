{
    "WTF_VERSION": "4.2",
	"icon": "ui_iconsTotal_found_thing",
    "quest_givers": [
		{"Mercenary": true, "Medic": true}
	],
    "preconditions": [
		"$ db.actor:community_goodwill(|CACHE.tg_community|) >= 700"
	],
    "tg_community": "$ igi_helper.get_community_by_id(|CACHE.task_giver_id|)",

    "description": {
		"locations": ["$ igi_description.get_smart_name_by_id(|frame.smart|)"],
		"targets": ["$ igi_description.item_name_by_section(|frame_alive.package_section|)"]
	},

    "frames": [
    {
        "src": "Community/medic_package/start.json",
        "smart": "?$ |this.smarts|[1]",

        "level": "$ wtf.shuffle(igi_finder.get_levels(1,1))[1]",
        "all_smarts": "$ igi_finder.get_smarts_by_lvl(|this.level|)",
        "smarts": "$ wtf.shuffle(|this.all_smarts|)",
        "link_id": "frame",

        "finished_in_time": true
    },
    {
        "entities": [],
        "NEXT_FRAME": "@$ |frame.finished_in_time| and |frame_alive.FRAME_ID| or |frame_dead.FRAME_ID|"
    },
    {
        "src": "Community/medic_package/alive.json",
        "squad_id": "init$ |frame.squad_id|",
        "package_section": "special_delivery_case",

        "link_id": "frame_alive",
        "NEXT_FRAME": -1
    },
    {
        "src": "Community/medic_package/dead.json",
        "smart_id":"?$ |frame.smarts|[2]",
        "squad_id": "init$ |frame.squad_id|",
        "package_section": "$ |frame_alive.package_section|",
        "commander_id": "init$ |frame.commander_id|",

        "pda_msg": "init$ igi_helper.pda_message('igi_task_text_community_medic_package_dead_msg', |CACHE.task_giver_id|, 'beep_1') or 1",
        "link_id": "frame_dead"
    }
    ],
	"rewards": {
		"money": "@$ |frame.finished_in_time| and 16000 or 8000",
		"goodwill": 50
	}
}