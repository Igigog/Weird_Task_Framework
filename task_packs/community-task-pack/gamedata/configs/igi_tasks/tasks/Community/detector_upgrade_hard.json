{
	"WTF_VERSION": "4.3",
	"tg_community": "$ igi_helper.get_community_by_id(|CACHE.task_giver_id|)",
	"description": {
		"locations": "$ wtf.map(|scan.zone_ids|, function(x) return 'st_' .. alife_object(x):name():gsub('_spot', '_name_land') end)"
	},
	"preconditions": [
		"$ not has_alife_info(|CACHE.quest_info_portion|)",
		"$ db.actor:object('detector_elite') ~= nil",
		"$ get_actor_true_community() == 'ecolog'",
		"$ db.actor:community_goodwill(|CACHE.tg_community|) >= 2000"
	],
    "frames": [
    {
		"src": "Community/detector_upgrade/anomaly_scan.json",
		"zone_ids": "$ wtf.map(|CACHE.zones|, function(x) return db.zone_by_name[x]:id() end)",
		"sender": "$ get_story_object_id('jup_b6_scientist_tech')",
		"visit_on_progress": {
			"steps": [
			[1, "@$ igi_helper.pda_message('igi_task_text_anomaly_scan_open_detector_hard', |inputs.sender|) or 1"]
			]
		},
		"scan_on_progress": {
			"reset": "@$ igi_helper.pda_message('igi_task_text_anomaly_scan_reset_hard', |inputs.sender|) or 1",
			"steps": [
			[0.01, "@$ igi_helper.pda_message('igi_task_text_anomaly_scan_started_hard', |inputs.sender|) or 1"],
			[1, "@$ igi_helper.pda_message('igi_task_text_anomaly_scan_done_hard', |inputs.sender|) or 1"]
			] 
		},
		"link_id": "scan"
    },

	{
		"entities": [{
			"id": "init$ |scan.detector_id|",
			"CONTROLLER": "@$ igi_target_return.Return"
		},{
			"section_name": "detector_elite",
			"CONTROLLER": "@$ igi_target_fetch.Fetch"
		}]
	}

	
    ],
	"zones": [
		"jup_b25_spot",
		"jup_b211_spot",
		"jup_b201_spot",
		"jup_b32_spot",
		"jup_b1_spot",
		"jup_b209_spot",
		"jup_b206_spot"
	],
	"rewards": {
		"money": 12000,
		"goodwill": 100
	},
	"reward_detector": "on_complete$ igi_helper.give_to_actor('detector_scientific')",
	"quest_done": "on_complete$ give_info(|CACHE.quest_info_portion|) or 1",
	"quest_info_portion": "igi_yantar_detector_upgrade_hard_done",
	"quest_givers": [
		{"Ecolog": true, "Leader": true, "Jupiter": true}
	]
}
