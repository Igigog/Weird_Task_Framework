			"GEN": "@$ igi_generate.Split('smart_ids', 'id')",
            "CONTROLLER": "@$ igi_target_visit.Visit",
			"link_id": "smart",
			"subtask": true
		}
	],
	"rewards": {
		"money": 600,
		"goodwill": 50
