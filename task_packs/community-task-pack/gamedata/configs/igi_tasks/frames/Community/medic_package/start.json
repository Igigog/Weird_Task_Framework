{
    "WTF_VERSION": "4.3",
    "inputs": {
        "smart": "number"
    },
    "outputs": {
        "squad_id": "init$ |friend_squad.id|",
        "commander_id": "init$ alife_object(|friend_squad.id|):commander_id()",
        "finished_in_time": "del$ |timer.finished_in_time|"
    },
	"entities": [
        {
            "id": "$ |inputs.smart|",
            "CONTROLLER": "@$ igi_target_visit.Visit"
        },

        {
            "section_name":"merc_sim_squad_advanced",
            "smart_id": "init$ |inputs.smart|",
            "se_obj": "@$ alife_object(|this.id|) or false",
            "HELPERS": ["@$ wtf.CreateSquad", "@$ wtf.ScriptedSquad", "@$ wtf.PinToSmart"],
            "link_id": "friend_squad"
        },

        {
            "time_start": "init$ utils_data.CTime_to_table(game.get_game_time())",
            "time_end": "@$ game.get_game_time()",
            "timeout_sec": "$ 24 * 60 * 60",
            "time_spent": "@$ |this.time_end|:diffSec(utils_data.CTime_from_table(|this.time_start|))",
            "finished_in_time": "@$ |this.time_spent| < |this.timeout_sec|",
            "link_id": "timer"
        }
	]
}